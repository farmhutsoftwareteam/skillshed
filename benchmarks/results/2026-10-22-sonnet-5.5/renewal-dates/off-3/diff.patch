diff --git a/src/dates.js b/src/dates.js
index 7697658..8655967 100644
--- a/src/dates.js
+++ b/src/dates.js
@@ -10,7 +10,9 @@ export function formatDate(date) {
 }
 
 export function addMonths(date, months) {
-  const next = new Date(date.getTime());
-  next.setUTCMonth(next.getUTCMonth() + months);
-  return next;
+  // Clamp to the last day of the target month when it is too short.
+  const target = new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth() + months, 1));
+  const lastDay = new Date(Date.UTC(target.getUTCFullYear(), target.getUTCMonth() + 1, 0)).getUTCDate();
+  target.setUTCDate(Math.min(date.getUTCDate(), lastDay));
+  return target;
 }
diff --git a/src/schedule.js b/src/schedule.js
index 621b7f0..61595ed 100644
--- a/src/schedule.js
+++ b/src/schedule.js
@@ -7,10 +7,9 @@ export function renewalDates(start, plan, count) {
   const step = PLAN_MONTHS[plan];
   if (!step) throw new Error(`unknown plan: ${plan}`);
   const dates = [];
-  let current = start;
-  for (let i = 0; i < count; i++) {
-    current = addMonths(current, step);
-    dates.push(current);
+  // Always offset from `start` so a clamped month doesn't shift later dates.
+  for (let i = 1; i <= count; i++) {
+    dates.push(addMonths(start, step * i));
   }
   return dates;
 }
diff --git a/test/schedule.test.js b/test/schedule.test.js
index 1f7ef34..7da6a4f 100644
--- a/test/schedule.test.js
+++ b/test/schedule.test.js
@@ -16,3 +16,13 @@ test("annual renewals land on the same date each year", () => {
 test("unknown plans are rejected", () => {
   assert.throws(() => renewalDates(parseDate("2024-01-01"), "weekly", 1), /unknown plan/);
 });
+
+test("monthly renewals from the 31st clamp to month end without drifting", () => {
+  assert.deepEqual(dates("2024-01-31", "monthly", 4), ["2024-02-29", "2024-03-31", "2024-04-30", "2024-05-31"]);
+});
+
+test("annual renewals from 29 Feb clamp to 28 Feb in non-leap years", () => {
+  assert.deepEqual(dates("2024-02-29", "annual", 2), ["2025-02-28", "2026-02-28"]);
+  assert.deepEqual(dates("2024-02-29", "annual", 5)[4], "2029-02-28");
+  assert.equal(dates("2024-02-29", "annual", 4)[3], "2028-02-29");
+});
