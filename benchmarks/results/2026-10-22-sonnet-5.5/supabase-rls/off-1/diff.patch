diff --git a/supabase/migrations/20260102000000_enable_rls.sql b/supabase/migrations/20260102000000_enable_rls.sql
new file mode 100644
index 0000000..d9b7af1
--- /dev/null
+++ b/supabase/migrations/20260102000000_enable_rls.sql
@@ -0,0 +1,84 @@
+-- Row-level security for teams, team_members and projects.
+
+alter table public.teams enable row level security;
+alter table public.team_members enable row level security;
+alter table public.projects enable row level security;
+
+-- Signed-out visitors (anon) get no access at all.
+revoke all on public.teams, public.team_members, public.projects, public.project_overview from anon;
+
+-- Membership helpers. SECURITY DEFINER so the lookup on team_members does not
+-- re-trigger team_members' own policies (which would recurse infinitely).
+-- They live in a schema that is not exposed through the API.
+create schema if not exists private;
+revoke all on schema private from public;
+grant usage on schema private to authenticated;
+
+create function private.is_team_member(_team_id uuid)
+returns boolean
+language sql
+stable
+security definer
+set search_path = ''
+as $$
+  select exists (
+    select 1 from public.team_members
+    where team_id = _team_id and user_id = (select auth.uid())
+  );
+$$;
+
+create function private.is_team_admin(_team_id uuid)
+returns boolean
+language sql
+stable
+security definer
+set search_path = ''
+as $$
+  select exists (
+    select 1 from public.team_members
+    where team_id = _team_id and user_id = (select auth.uid()) and role = 'admin'
+  );
+$$;
+
+revoke all on function private.is_team_member(uuid), private.is_team_admin(uuid) from public, anon;
+grant execute on function private.is_team_member(uuid), private.is_team_admin(uuid) to authenticated;
+
+-- teams: members can read their teams.
+create policy "members can view their teams"
+  on public.teams for select to authenticated
+  using (private.is_team_member(id));
+
+-- team_members: members can see fellow members; only admins add or remove.
+create policy "members can view team members"
+  on public.team_members for select to authenticated
+  using (private.is_team_member(team_id));
+
+create policy "admins can add team members"
+  on public.team_members for insert to authenticated
+  with check (private.is_team_admin(team_id));
+
+create policy "admins can remove team members"
+  on public.team_members for delete to authenticated
+  using (private.is_team_admin(team_id));
+
+-- projects: members can read; only admins write.
+create policy "members can view team projects"
+  on public.projects for select to authenticated
+  using (private.is_team_member(team_id));
+
+create policy "admins can create team projects"
+  on public.projects for insert to authenticated
+  with check (private.is_team_admin(team_id));
+
+create policy "admins can edit team projects"
+  on public.projects for update to authenticated
+  using (private.is_team_admin(team_id))
+  with check (private.is_team_admin(team_id));
+
+create policy "admins can delete team projects"
+  on public.projects for delete to authenticated
+  using (private.is_team_admin(team_id));
+
+-- Views run as their owner by default, which would bypass RLS on the
+-- underlying tables. Make the view use the caller's permissions instead.
+alter view public.project_overview set (security_invoker = true);
