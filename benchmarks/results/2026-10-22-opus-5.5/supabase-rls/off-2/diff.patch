diff --git a/supabase/migrations/20261022000000_enable_rls.sql b/supabase/migrations/20261022000000_enable_rls.sql
new file mode 100644
index 0000000..6368969
--- /dev/null
+++ b/supabase/migrations/20261022000000_enable_rls.sql
@@ -0,0 +1,128 @@
+-- Row-level security for teams, team_members and projects.
+--
+-- Signed-in users can read their own teams, those teams' members and projects.
+-- Only team admins can write projects and manage membership.
+-- Signed-out visitors (anon) get nothing.
+
+-- Membership checks live in a schema the Data API does not expose. They are
+-- security definer so policies on team_members can call them without
+-- recursing into team_members' own policies.
+create schema if not exists private;
+revoke all on schema private from public;
+grant usage on schema private to authenticated;
+
+create or replace function private.is_team_member(p_team_id uuid)
+returns boolean
+language sql
+stable
+security definer
+set search_path = ''
+as $$
+  select exists (
+    select 1
+    from public.team_members tm
+    where tm.team_id = p_team_id
+      and tm.user_id = (select auth.uid())
+  );
+$$;
+
+create or replace function private.is_team_admin(p_team_id uuid)
+returns boolean
+language sql
+stable
+security definer
+set search_path = ''
+as $$
+  select exists (
+    select 1
+    from public.team_members tm
+    where tm.team_id = p_team_id
+      and tm.user_id = (select auth.uid())
+      and tm.role = 'admin'
+  );
+$$;
+
+revoke all on function private.is_team_member(uuid) from public, anon;
+revoke all on function private.is_team_admin(uuid) from public, anon;
+grant execute on function private.is_team_member(uuid) to authenticated;
+grant execute on function private.is_team_admin(uuid) to authenticated;
+
+-- Policies look up memberships by user.
+create index if not exists team_members_user_id_idx on public.team_members (user_id);
+
+-- Signed-out visitors get no access at all, independent of policies.
+revoke all on public.teams, public.team_members, public.projects, public.project_overview from anon;
+
+-- teams ---------------------------------------------------------------------
+
+alter table public.teams enable row level security;
+
+create policy "Members can view their teams"
+  on public.teams for select
+  to authenticated
+  using (private.is_team_member(id));
+
+-- No insert/update/delete policies: teams are not writable through the Data API.
+
+-- team_members --------------------------------------------------------------
+
+alter table public.team_members enable row level security;
+
+create policy "Members can view members of their teams"
+  on public.team_members for select
+  to authenticated
+  using (private.is_team_member(team_id));
+
+create policy "Admins can add team members"
+  on public.team_members for insert
+  to authenticated
+  with check (private.is_team_admin(team_id));
+
+create policy "Admins can update team members"
+  on public.team_members for update
+  to authenticated
+  using (private.is_team_admin(team_id))
+  with check (private.is_team_admin(team_id));
+
+create policy "Admins can remove team members"
+  on public.team_members for delete
+  to authenticated
+  using (private.is_team_admin(team_id));
+
+-- projects ------------------------------------------------------------------
+
+alter table public.projects enable row level security;
+
+alter table public.projects alter column created_by set default auth.uid();
+
+create policy "Members can view their teams' projects"
+  on public.projects for select
+  to authenticated
+  using (private.is_team_member(team_id));
+
+create policy "Admins can create projects"
+  on public.projects for insert
+  to authenticated
+  with check (
+    private.is_team_admin(team_id)
+    and created_by = (select auth.uid())
+  );
+
+-- with check also applies to the new row, so a project cannot be moved into a
+-- team where the caller is not an admin.
+create policy "Admins can update projects"
+  on public.projects for update
+  to authenticated
+  using (private.is_team_admin(team_id))
+  with check (private.is_team_admin(team_id));
+
+create policy "Admins can delete projects"
+  on public.projects for delete
+  to authenticated
+  using (private.is_team_admin(team_id));
+
+-- project_overview ----------------------------------------------------------
+
+-- Views run with the owner's privileges by default, which would bypass RLS on
+-- projects and teams. Make the view evaluate RLS as the querying user.
+alter view public.project_overview set (security_invoker = true);
