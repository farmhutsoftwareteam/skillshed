diff --git a/supabase/migrations/20260102000000_rls.sql b/supabase/migrations/20260102000000_rls.sql
new file mode 100644
index 0000000..7b2ea43
--- /dev/null
+++ b/supabase/migrations/20260102000000_rls.sql
@@ -0,0 +1,114 @@
+-- Row-level security for teams, team_members and projects.
+--
+-- Members can read their teams, those teams' members and projects.
+-- Only team admins can write projects and add/remove members.
+-- Signed-out visitors (anon) get nothing.
+
+-- Membership helpers. They are security definer so policies on team_members
+-- can consult team_members without recursing into its own RLS. They live in
+-- a schema the Data API does not expose.
+create schema if not exists private;
+revoke all on schema private from public, anon;
+grant usage on schema private to authenticated;
+
+create function private.is_team_member(p_team_id uuid)
+returns boolean
+language sql
+stable
+security definer
+set search_path = ''
+as $$
+  select exists (
+    select 1 from public.team_members m
+    where m.team_id = p_team_id
+      and m.user_id = (select auth.uid())
+  );
+$$;
+
+create function private.is_team_admin(p_team_id uuid)
+returns boolean
+language sql
+stable
+security definer
+set search_path = ''
+as $$
+  select exists (
+    select 1 from public.team_members m
+    where m.team_id = p_team_id
+      and m.user_id = (select auth.uid())
+      and m.role = 'admin'
+  );
+$$;
+
+revoke all on function private.is_team_member(uuid) from public, anon;
+revoke all on function private.is_team_admin(uuid) from public, anon;
+grant execute on function private.is_team_member(uuid) to authenticated;
+grant execute on function private.is_team_admin(uuid) to authenticated;
+
+-- Supports the user_id lookups above and in the policies below.
+create index team_members_user_id_idx on public.team_members (user_id);
+
+-- Record the creator automatically; the insert policy rejects spoofed values.
+alter table public.projects alter column created_by set default auth.uid();
+
+alter table public.teams enable row level security;
+alter table public.team_members enable row level security;
+alter table public.projects enable row level security;
+
+-- Signed-out visitors have no business with these tables at all.
+revoke all on public.teams, public.team_members, public.projects from anon;
+
+-- teams: members read. No write policies, so creating, renaming or deleting
+-- teams is left to the service role.
+create policy "Members can view their teams"
+  on public.teams for select
+  to authenticated
+  using (private.is_team_member(id));
+
+-- team_members: members read their teams' rosters; admins add and remove.
+create policy "Members can view their teams' members"
+  on public.team_members for select
+  to authenticated
+  using (private.is_team_member(team_id));
+
+create policy "Admins can add team members"
+  on public.team_members for insert
+  to authenticated
+  with check (private.is_team_admin(team_id));
+
+create policy "Admins can remove team members"
+  on public.team_members for delete
+  to authenticated
+  using (private.is_team_admin(team_id));
+
+-- projects: members read; admins create, edit and delete.
+create policy "Members can view their teams' projects"
+  on public.projects for select
+  to authenticated
+  using (private.is_team_member(team_id));
+
+create policy "Admins can create projects"
+  on public.projects for insert
+  to authenticated
+  with check (
+    private.is_team_admin(team_id)
+    and created_by = (select auth.uid())
+  );
+
+-- with check also covers moving a project: the target team must be one the
+-- user administers too.
+create policy "Admins can update projects"
+  on public.projects for update
+  to authenticated
+  using (private.is_team_admin(team_id))
+  with check (private.is_team_admin(team_id));
+
+create policy "Admins can delete projects"
+  on public.projects for delete
+  to authenticated
+  using (private.is_team_admin(team_id));
+
+-- Views run as their owner by default, which would bypass RLS on the tables
+-- underneath. Make project_overview respect the caller's policies.
+alter view public.project_overview set (security_invoker = true);
+revoke all on public.project_overview from anon;
