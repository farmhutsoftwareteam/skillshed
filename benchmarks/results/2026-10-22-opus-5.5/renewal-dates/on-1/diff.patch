   assert.equal(first.date, "2025-05-01");
 });
+
+test("ticket #4471: month-end starts are billed on the last day of short months", () => {
+  const monthly = upcomingInvoices({ start: "2024-01-31", plan: "monthly", tier: "pro" }, 3).map((l) => l.date);
+  assert.deepEqual(monthly, ["2024-02-29", "2024-03-31", "2024-04-30"]);
