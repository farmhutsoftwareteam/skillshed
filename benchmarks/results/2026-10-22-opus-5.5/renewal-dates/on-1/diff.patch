+  assert.equal(annual.date, "2025-02-28");
+});
diff --git a/test/schedule.test.js b/test/schedule.test.js
index 1f7ef34..a43eb4b 100644
--- a/test/schedule.test.js
+++ b/test/schedule.test.js
@@ -16,3 +16,16 @@ test("annual renewals land on the same date each year", () => {
 test("unknown plans are rejected", () => {
   assert.throws(() => renewalDates(parseDate("2024-01-01"), "weekly", 1), /unknown plan/);
 });
+
+test("monthly renewals clamp to the last day of short months without drifting", () => {
+  assert.deepEqual(dates("2024-01-31", "monthly", 4), ["2024-02-29", "2024-03-31", "2024-04-30", "2024-05-31"]);
+  assert.deepEqual(dates("2023-01-31", "monthly", 2), ["2023-02-28", "2023-03-31"]);
+});
+
+test("annual renewals from a leap day fall on 28 February in non-leap years", () => {
+  assert.deepEqual(dates("2024-02-29", "annual", 4), ["2025-02-28", "2026-02-28", "2027-02-28", "2028-02-29"]);
+});
+
+test("renewals cross year boundaries", () => {
+  assert.deepEqual(dates("2024-11-30", "monthly", 3), ["2024-12-30", "2025-01-30", "2025-02-28"]);
+});
