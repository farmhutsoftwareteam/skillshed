diff --git a/src/dates.js b/src/dates.js
index 7697658..b8b8354 100644
--- a/src/dates.js
+++ b/src/dates.js
@@ -9,8 +9,11 @@ export function formatDate(date) {
   return date.toISOString().slice(0, 10);
 }
 
+// Adds calendar months, clamping to the last day of the target month when the
+// day doesn't exist there (31 Jan + 1 month = 29 Feb 2024, not 2 Mar).
 export function addMonths(date, months) {
-  const next = new Date(date.getTime());
-  next.setUTCMonth(next.getUTCMonth() + months);
-  return next;
+  const y = date.getUTCFullYear();
+  const m = date.getUTCMonth() + months;
+  const lastDay = new Date(Date.UTC(y, m + 1, 0)).getUTCDate();
+  return new Date(Date.UTC(y, m, Math.min(date.getUTCDate(), lastDay)));
 }
diff --git a/src/schedule.js b/src/schedule.js
index 621b7f0..6bd5931 100644
--- a/src/schedule.js
+++ b/src/schedule.js
@@ -6,11 +6,11 @@ const PLAN_MONTHS = { monthly: 1, annual: 12 };
 export function renewalDates(start, plan, count) {
   const step = PLAN_MONTHS[plan];
   if (!step) throw new Error(`unknown plan: ${plan}`);
+  // Always count from the start date so a clamped renewal (e.g. 29 Feb) doesn't
+  // pull every later renewal back to that day.
   const dates = [];
-  let current = start;
-  for (let i = 0; i < count; i++) {
-    current = addMonths(current, step);
-    dates.push(current);
+  for (let i = 1; i <= count; i++) {
+    dates.push(addMonths(start, step * i));
   }
   return dates;
 }
diff --git a/test/schedule.test.js b/test/schedule.test.js
index 1f7ef34..dae2756 100644
--- a/test/schedule.test.js
+++ b/test/schedule.test.js
@@ -16,3 +16,12 @@ test("annual renewals land on the same date each year", () => {
 test("unknown plans are rejected", () => {
   assert.throws(() => renewalDates(parseDate("2024-01-01"), "weekly", 1), /unknown plan/);
 });
+
+test("monthly renewals fall on the last day of shorter months", () => {
+  assert.deepEqual(dates("2024-01-31", "monthly", 4), ["2024-02-29", "2024-03-31", "2024-04-30", "2024-05-31"]);
+  assert.deepEqual(dates("2023-01-31", "monthly", 1), ["2023-02-28"]);
+});
+
+test("annual renewals from a leap day fall on 28 February", () => {
+  assert.deepEqual(dates("2024-02-29", "annual", 4), ["2025-02-28", "2026-02-28", "2027-02-28", "2028-02-29"]);
+});
