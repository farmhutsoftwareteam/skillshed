diff --git a/src/dates.js b/src/dates.js
index 7697658..db633d2 100644
--- a/src/dates.js
+++ b/src/dates.js
@@ -9,8 +9,11 @@ export function formatDate(date) {
   return date.toISOString().slice(0, 10);
 }
 
+// Adds calendar months, clamping to the last day of the target month when it
+// is too short (31 Jan + 1 month = 29 Feb in a leap year, not 2 Mar).
 export function addMonths(date, months) {
-  const next = new Date(date.getTime());
-  next.setUTCMonth(next.getUTCMonth() + months);
-  return next;
+  const target = date.getUTCMonth() + months;
+  const y = date.getUTCFullYear();
+  const lastDay = new Date(Date.UTC(y, target + 1, 0)).getUTCDate();
+  return new Date(Date.UTC(y, target, Math.min(date.getUTCDate(), lastDay)));
 }
diff --git a/src/schedule.js b/src/schedule.js
index 621b7f0..a9e3274 100644
--- a/src/schedule.js
+++ b/src/schedule.js
@@ -7,10 +7,10 @@ export function renewalDates(start, plan, count) {
   const step = PLAN_MONTHS[plan];
   if (!step) throw new Error(`unknown plan: ${plan}`);
   const dates = [];
-  let current = start;
-  for (let i = 0; i < count; i++) {
-    current = addMonths(current, step);
-    dates.push(current);
+  // Always step from `start`, not the previous renewal, so a date clamped in a
+  // short month doesn't drag later renewals earlier (31 Jan -> 29 Feb -> 31 Mar).
+  for (let i = 1; i <= count; i++) {
+    dates.push(addMonths(start, step * i));
   }
   return dates;
 }
diff --git a/test/schedule.test.js b/test/schedule.test.js
