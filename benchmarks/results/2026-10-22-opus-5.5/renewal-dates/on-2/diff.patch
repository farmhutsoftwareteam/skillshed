 });
 
+test("monthly renewals clamp to the end of short months and recover", () => {
+  assert.deepEqual(dates("2024-01-31", "monthly", 4), ["2024-02-29", "2024-03-31", "2024-04-30", "2024-05-31"]);
+  assert.deepEqual(dates("2023-01-31", "monthly", 2), ["2023-02-28", "2023-03-31"]);
+});
+
+test("annual renewals from 29 February clamp to 28 February", () => {
+  assert.deepEqual(dates("2024-02-29", "annual", 4), ["2025-02-28", "2026-02-28", "2027-02-28", "2028-02-29"]);
+});
+
 test("unknown plans are rejected", () => {
   assert.throws(() => renewalDates(parseDate("2024-01-01"), "weekly", 1), /unknown plan/);
 });
