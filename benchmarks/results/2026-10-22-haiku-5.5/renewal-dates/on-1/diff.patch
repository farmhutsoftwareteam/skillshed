diff --git a/src/dates.js b/src/dates.js
index 7697658..d45c09d 100644
--- a/src/dates.js
+++ b/src/dates.js
@@ -9,8 +9,12 @@ export function formatDate(date) {
   return date.toISOString().slice(0, 10);
 }
 
+// Adds calendar months, clamping the day to the last day of the target month
+// (31 Jan + 1 month = 28/29 Feb), rather than letting it overflow into the next.
 export function addMonths(date, months) {
-  const next = new Date(date.getTime());
-  next.setUTCMonth(next.getUTCMonth() + months);
-  return next;
+  const firstOfTarget = new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth() + months, 1));
+  const year = firstOfTarget.getUTCFullYear();
+  const month = firstOfTarget.getUTCMonth();
+  const lastDay = new Date(Date.UTC(year, month + 1, 0)).getUTCDate();
+  return new Date(Date.UTC(year, month, Math.min(date.getUTCDate(), lastDay)));
 }
diff --git a/src/schedule.js b/src/schedule.js
index 621b7f0..1e14e77 100644
--- a/src/schedule.js
+++ b/src/schedule.js
@@ -3,14 +3,14 @@ import { addMonths } from "./dates.js";
 const PLAN_MONTHS = { monthly: 1, annual: 12 };
 
 // The next `count` renewal dates for a subscription that started on `start`.
+// Each date is counted from `start`, not from the previous renewal, so a short
+// month (e.g. 29 Feb) doesn't shift every later renewal off the original day.
 export function renewalDates(start, plan, count) {
   const step = PLAN_MONTHS[plan];
   if (!step) throw new Error(`unknown plan: ${plan}`);
   const dates = [];
-  let current = start;
-  for (let i = 0; i < count; i++) {
-    current = addMonths(current, step);
-    dates.push(current);
+  for (let i = 1; i <= count; i++) {
+    dates.push(addMonths(start, step * i));
   }
   return dates;
 }
