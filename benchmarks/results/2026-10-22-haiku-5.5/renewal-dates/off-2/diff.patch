diff --git a/src/dates.js b/src/dates.js
index 7697658..f99abbf 100644
--- a/src/dates.js
+++ b/src/dates.js
@@ -9,8 +9,12 @@ export function formatDate(date) {
   return date.toISOString().slice(0, 10);
 }
 
+// Adds calendar months, clamping to the last day of the target month when the
+// original day doesn't exist there (31 Jan + 1 month = 29 Feb in a leap year).
 export function addMonths(date, months) {
-  const next = new Date(date.getTime());
-  next.setUTCMonth(next.getUTCMonth() + months);
-  return next;
+  const year = date.getUTCFullYear();
+  const month = date.getUTCMonth() + months;
+  // Day 0 of the following month is the last day of `month`; Date.UTC normalises overflow.
+  const lastDay = new Date(Date.UTC(year, month + 1, 0)).getUTCDate();
+  return new Date(Date.UTC(year, month, Math.min(date.getUTCDate(), lastDay)));
 }
diff --git a/src/schedule.js b/src/schedule.js
index 621b7f0..5d70df8 100644
--- a/src/schedule.js
+++ b/src/schedule.js
@@ -7,10 +7,10 @@ export function renewalDates(start, plan, count) {
   const step = PLAN_MONTHS[plan];
   if (!step) throw new Error(`unknown plan: ${plan}`);
   const dates = [];
-  let current = start;
-  for (let i = 0; i < count; i++) {
-    current = addMonths(current, step);
-    dates.push(current);
+  // Always count from the original start, so a clamped date (e.g. 29 Feb) doesn't
+  // pull later renewals onto the clamped day (they return to 31 Mar, not 29 Mar).
+  for (let i = 1; i <= count; i++) {
+    dates.push(addMonths(start, step * i));
   }
   return dates;
 }
