diff --git a/src/dates.js b/src/dates.js
index 7697658..c6c3884 100644
--- a/src/dates.js
+++ b/src/dates.js
@@ -9,8 +9,13 @@ export function formatDate(date) {
   return date.toISOString().slice(0, 10);
 }
 
+// Adds calendar months, clamping to the last day of the target month when the
+// source day does not exist there (31 Jan + 1 month = 29 Feb in a leap year).
+// Plain setUTCMonth would overflow into the following month instead.
 export function addMonths(date, months) {
-  const next = new Date(date.getTime());
-  next.setUTCMonth(next.getUTCMonth() + months);
-  return next;
+  const day = date.getUTCDate();
+  const firstOfTarget = new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth() + months, 1));
+  const lastDay = new Date(Date.UTC(firstOfTarget.getUTCFullYear(), firstOfTarget.getUTCMonth() + 1, 0)).getUTCDate();
+  firstOfTarget.setUTCDate(Math.min(day, lastDay));
+  return firstOfTarget;
 }
diff --git a/src/schedule.js b/src/schedule.js
index 621b7f0..62d0c34 100644
--- a/src/schedule.js
+++ b/src/schedule.js
@@ -3,14 +3,14 @@ import { addMonths } from "./dates.js";
 const PLAN_MONTHS = { monthly: 1, annual: 12 };
 
 // The next `count` renewal dates for a subscription that started on `start`.
+// Each date is computed from `start`, not from the previous renewal, so a
+// clamped date (e.g. 28 Feb) does not pull later renewals off their anchor day.
 export function renewalDates(start, plan, count) {
   const step = PLAN_MONTHS[plan];
   if (!step) throw new Error(`unknown plan: ${plan}`);
   const dates = [];
-  let current = start;
-  for (let i = 0; i < count; i++) {
-    current = addMonths(current, step);
-    dates.push(current);
+  for (let i = 1; i <= count; i++) {
+    dates.push(addMonths(start, step * i));
   }
   return dates;
 }
