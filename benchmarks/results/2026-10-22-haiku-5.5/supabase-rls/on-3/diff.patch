diff --git a/supabase/migrations/20261022120000_row_level_security.sql b/supabase/migrations/20261022120000_row_level_security.sql
new file mode 100644
index 0000000..175416e
--- /dev/null
+++ b/supabase/migrations/20261022120000_row_level_security.sql
@@ -0,0 +1,135 @@
+-- Row-level security for teams, team_members and projects.
+--
+-- Rules:
+--   * Signed-in users see the teams they belong to, those teams' members and projects.
+--   * Only a team's admins create, edit or delete that team's projects, and add
+--     or remove that team's members.
+--   * Everyone else sees and changes nothing. Signed-out visitors (anon) see nothing.
+
+-- Membership checks live outside the exposed schema. They are SECURITY DEFINER so
+-- they can read team_members without RLS recursing into the team_members policies.
+-- Each check is keyed on auth.uid(), so a caller can only learn about their own
+-- memberships.
+create schema if not exists private;
+
+create or replace function private.is_team_member(p_team_id uuid)
+returns boolean
+language sql
+stable
+security definer
+set search_path = ''
+as $$
+  select exists (
+    select 1
+    from public.team_members tm
+    where tm.team_id = p_team_id
+      and tm.user_id = (select auth.uid())
+  );
+$$;
+
+create or replace function private.is_team_admin(p_team_id uuid)
+returns boolean
+language sql
+stable
+security definer
+set search_path = ''
+as $$
+  select exists (
+    select 1
+    from public.team_members tm
+    where tm.team_id = p_team_id
+      and tm.user_id = (select auth.uid())
+      and tm.role = 'admin'
+  );
+$$;
+
+-- Callable by signed-in users only. Postgres grants EXECUTE to PUBLIC by default.
+revoke all on function private.is_team_member(uuid) from public;
+revoke all on function private.is_team_admin(uuid) from public;
+grant usage on schema private to authenticated;
+grant execute on function private.is_team_member(uuid) to authenticated;
+grant execute on function private.is_team_admin(uuid) to authenticated;
+
+-- Index for the "teams I belong to" lookup. The primary key covers team_id.
+create index if not exists team_members_user_id_idx on public.team_members (user_id);
+
+-- Enable RLS and remove anon access. Signed-out visitors get nothing.
+alter table public.teams enable row level security;
+alter table public.team_members enable row level security;
+alter table public.projects enable row level security;
+
+revoke all on public.teams from anon;
+revoke all on public.team_members from anon;
+revoke all on public.projects from anon;
+revoke all on public.project_overview from anon;
+
+-- Signed-in users get only the privileges the policies below need. RLS still decides the rows.
+-- Teams are not inserted from the client, and team_members rows are not updated.
+grant select, update, delete on public.teams to authenticated;
+grant select, insert, delete on public.team_members to authenticated;
+grant select, insert, update, delete on public.projects to authenticated;
+
+-- Teams. Users can read and rename/delete the teams they administer.
+-- Teams are not created from the client here. That needs a bootstrap path (for
+-- example a SECURITY DEFINER RPC that also inserts the creator as admin), added separately.
+create policy teams_select_members on public.teams
+  for select
+  to authenticated
+  using (private.is_team_member(id));
+
+create policy teams_update_admins on public.teams
+  for update
+  to authenticated
+  using (private.is_team_admin(id))
+  with check (private.is_team_admin(id));
+
+create policy teams_delete_admins on public.teams
+  for delete
+  to authenticated
+  using (private.is_team_admin(id));
+
+-- Team members. Members see their team's roster. Only admins add or remove people.
+-- No update policy: role changes are denied for everyone.
+create policy team_members_select_members on public.team_members
+  for select
+  to authenticated
+  using (private.is_team_member(team_id));
+
+create policy team_members_insert_admins on public.team_members
+  for insert
+  to authenticated
+  with check (private.is_team_admin(team_id));
+
+create policy team_members_delete_admins on public.team_members
+  for delete
+  to authenticated
+  using (private.is_team_admin(team_id));
+
+-- Projects. Members read. Only admins create, edit or delete.
+-- The update policy's WITH CHECK also stops a project being moved into a team the
+-- caller does not administer.
+create policy projects_select_members on public.projects
+  for select
+  to authenticated
+  using (private.is_team_member(team_id));
+
+create policy projects_insert_admins on public.projects
+  for insert
+  to authenticated
+  with check (private.is_team_admin(team_id));
+
+create policy projects_update_admins on public.projects
+  for update
+  to authenticated
+  using (private.is_team_admin(team_id))
+  with check (private.is_team_admin(team_id));
+
+create policy projects_delete_admins on public.projects
+  for delete
+  to authenticated
+  using (private.is_team_admin(team_id));
+
+-- The view runs with the caller's permissions, so the base-table policies apply to it.
+-- Without security_invoker it would run as its owner and bypass RLS.
+alter view public.project_overview set (security_invoker = true);
+grant select on public.project_overview to authenticated;
