+-- Row-level security for teams, team_members and projects.
+--
+-- * Signed-in users see the teams they belong to, those teams' members and projects.
+-- * Only a team's admins can create, edit or delete its projects and add or remove its members.
+-- * Nothing belonging to a team you are not in is visible or changeable. Signed-out visitors see nothing.
+--
+-- Not covered by the spec, so no policy grants them: creating, renaming or deleting teams,
+-- and changing a member's role. Those are denied to the API roles until a policy is added.
+
+-- 1. Membership helpers.
+--    SECURITY DEFINER lets them read team_members without going through its own RLS policies,
+--    which would otherwise recurse back into these helpers.
+create schema if not exists private;
+grant usage on schema private to authenticated;
+
+create or replace function private.is_team_member(p_team_id uuid)
+returns boolean
+language sql
+stable
+security definer
+set search_path = ''
+as $$
+  select exists (
+    select 1
+    from public.team_members tm
+    where tm.team_id = p_team_id
+      and tm.user_id = (select auth.uid())
+  );
+$$;
+
+create or replace function private.is_team_admin(p_team_id uuid)
+returns boolean
+language sql
+stable
+security definer
+set search_path = ''
+as $$
+  select exists (
+    select 1
+    from public.team_members tm
+    where tm.team_id = p_team_id
+      and tm.user_id = (select auth.uid())
+      and tm.role = 'admin'
+  );
+$$;
+
+revoke all on function private.is_team_member(uuid) from public, anon;
+revoke all on function private.is_team_admin(uuid) from public, anon;
+grant execute on function private.is_team_member(uuid) to authenticated;
+grant execute on function private.is_team_admin(uuid) to authenticated;
+
+-- Policies look up team_members by user_id; the primary key only covers team_id first.
+create index if not exists team_members_user_id_idx on public.team_members (user_id);
+
+-- 2. Turn RLS on. With RLS enabled and no matching policy, a role gets no rows.
+alter table public.teams enable row level security;
+alter table public.team_members enable row level security;
+alter table public.projects enable row level security;
+
+-- 3. Table privileges. Start from nothing, then grant only what the policies below allow.
+--    The Data API exposes these tables to anon and authenticated by default.
+revoke all on public.teams, public.team_members, public.projects, public.project_overview
+  from anon, authenticated;
+
+grant select on public.teams to authenticated;
+grant select on public.team_members to authenticated;
+grant insert, delete on public.team_members to authenticated;
+grant select, insert, update, delete on public.projects to authenticated;
+grant select on public.project_overview to authenticated;
+
+-- 4. Policies. All are TO authenticated, so anon never matches one.
+create policy teams_select_member on public.teams
+  for select to authenticated
+  using (private.is_team_member(id));
+
+create policy team_members_select_member on public.team_members
+  for select to authenticated
+  using (private.is_team_member(team_id));
+
+create policy team_members_insert_admin on public.team_members
+  for insert to authenticated
+  with check (private.is_team_admin(team_id));
+
+create policy team_members_delete_admin on public.team_members
+  for delete to authenticated
+  using (private.is_team_admin(team_id));
+
+create policy projects_select_member on public.projects
+  for select to authenticated
+  using (private.is_team_member(team_id));
+
+create policy projects_insert_admin on public.projects
+  for insert to authenticated
+  with check (private.is_team_admin(team_id));
+
+-- The check also applies to the new row, so an admin can't move a project into a team they don't administer.
+create policy projects_update_admin on public.projects
+  for update to authenticated
+  using (private.is_team_admin(team_id))
+  with check (private.is_team_admin(team_id));
+
+create policy projects_delete_admin on public.projects
+  for delete to authenticated
+  using (private.is_team_admin(team_id));
+
+-- 5. The view runs as its owner by default, which would skip RLS on projects and teams.
+--    security_invoker makes it apply the caller's policies instead (Postgres 15+).
+alter view public.project_overview set (security_invoker = true);
